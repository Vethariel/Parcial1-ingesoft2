# Plantilla de variables de entorno. Copiar a .env y ajustar valores:
#   cp .env.example .env
# El archivo .env NO se versiona (contiene credenciales).

# --- Base de datos (las lee docker-compose.yml) ---
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_dev
POSTGRES_DB=ecommerce

POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Autenticación ---
# Clave para firmar los JWT. Generar una propia y larga, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria

# --- Conexión que usará Prisma (compuesta con las variables de arriba) ---
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public
